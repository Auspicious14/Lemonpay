{
  "expo": {
    "name": "LymPay",
    "slug": "lymepay",
    "scheme": "lympay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-icon/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.auspicious14.lymepay",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.auspicious14.lymepay",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/adaptive-icon.png",
        "monochromeImage": "./assets/app-icon/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon/adaptive-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon/notification-icon.png",
          "color": "#00A97A",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fca9e55c-7ece-4873-b6ac-20648c5fcc91"
      },
      "apiUrl": "https://lemon-api.uncutai.io/api"
    },
    "owner": "auspicious14"
  }
}
